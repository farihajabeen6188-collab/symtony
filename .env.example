# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# --- AI (Hugging Face Inference Providers) ---
# Create a token at https://huggingface.co/settings/tokens (permission: "Make calls to Inference Providers").
HUGGINGFACE_API_KEY=
# Optional: pin an inference provider (e.g. together, groq, novita). Empty = Hugging Face routes automatically.
HUGGINGFACE_PROVIDER=
# A chat model that supports tool calling + structured output. Verify with: make spike-ai
SYMTONY_AI_MODEL=Qwen/Qwen3.5-35B-A3B

# --- Ports (change if 8080/5433 are taken) ---
# These are read by docker compose from your shell or a root .env; listed here for reference.
# SYMTONY_HTTP_PORT=8080
# SYMTONY_DB_PORT=5433
