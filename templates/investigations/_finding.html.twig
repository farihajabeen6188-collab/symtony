{# One finding card. Input: f (Finding), evidence (array<ref, EvidenceItem>) #}
{% set ai = f.fromModel %}
<article class="rounded-lg border {{ f.verified ? (ai ? 'border-ai/30' : 'border-line') : 'border-dashed border-err/40 opacity-80' }} p-4" aria-label="{{ f.kind }}">
    <div class="mb-2 flex flex-wrap items-center gap-1.5">
        {% if f.kind == 'hypothesis' %}<span class="badge badge-warn">Hypothesis</span>{% elseif f.kind == 'fact' %}<span class="badge badge-blue">Fact</span>{% else %}<span class="badge badge-outline-dashed">Inference</span>{% endif %}
        {% if ai %}<span class="badge badge-ai" title="{{ f.source }}">{{ ux_icon('lucide:sparkles') }}AI</span>{% else %}<span class="badge badge-neutral" title="{{ f.source }}">{{ ux_icon('lucide:cpu') }}Heuristic</span>{% endif %}
        <span class="badge badge-neutral">Confidence {{ f.confidence }}</span>
        {% if f.verified %}
            <span class="badge badge-ok ml-auto">{{ ux_icon('lucide:shield-check') }}Verified</span>
        {% else %}
            <span class="badge badge-err ml-auto" title="{{ f.groundingReason }}">{{ ux_icon('lucide:shield-x') }}Rejected</span>
        {% endif %}
    </div>
    <p class="text-sm text-fg {{ f.kind == 'hypothesis' ? 'text-md font-medium' : '' }}">{{ f.statement }}</p>
    {% if f.rationale %}<p class="mt-1.5 text-sm text-fg-2">{{ f.rationale }}</p>{% endif %}
    {% if not f.verified %}<p class="mt-1.5 text-sm text-err">Not used in the report: {{ f.groundingReason }}</p>{% endif %}
    <div class="mt-3 flex flex-wrap items-center gap-1">
        <span class="text-2xs text-fg-3">Evidence</span>
        {% for ref in f.citations %}
            {% set ev = evidence[ref] ?? null %}
            <a href="#ev-{{ ref }}" class="tooltip badge {{ ev ? (ev.kind == 'context' ? 'badge-outline-dashed' : 'badge-neutral') : 'badge-err' }} font-mono hover:text-accent" data-tip="{{ ev ? ev.label|slice(0, 60) : 'Does not exist' }}">{{ ref }}</a>
        {% endfor %}
        {% for ref in f.contradictions %}
            <a href="#ev-{{ ref }}" class="badge badge-err font-mono" title="Contradicting evidence">≠ {{ ref }}</a>
        {% endfor %}
    </div>
</article>
