{% extends 'app/layout.html.twig' %}

{% block title %}Investigations{% endblock %}

{% block content %}
<twig:PageHeader title="Investigations" description="Evidence-grounded root-cause analyses. Every claim cites the events it rests on." />

{% if not ai_configured %}
    <div class="mb-4 flex items-start gap-3 rounded-lg border border-line-strong bg-surface-2 p-3 text-sm">
        {{ ux_icon('lucide:cpu', {class: 'mt-0.5 h-4 w-4 flex-none text-fg-3'}) }}
        <p class="text-fg-2"><span class="text-fg">Running on the heuristic engine.</span> {{ ai_reason }} Investigations still analyze the evidence with SYMTONY's deterministic analyzers; reports say which engine produced every finding.</p>
    </div>
{% endif %}

<div class="panel overflow-hidden">
    {% if result.items is empty %}
        <twig:EmptyState title="No investigations yet" illustration="no-results">
            Open an incident and choose Investigate. SYMTONY collects the evidence, reconstructs the timeline, and tests every claim against it.
            <twig:block name="actions"><a href="{{ path('app_incidents') }}" class="btn btn-primary">Open incidents</a></twig:block>
        </twig:EmptyState>
    {% else %}
        <div class="overflow-x-auto">
            <table class="table" data-controller="row-link">
                <thead><tr><th>Incident</th><th>Status</th><th>Engine</th><th class="hidden md:table-cell">Leading finding</th><th>Started</th><th class="text-right">Took</th></tr></thead>
                <tbody>
                    {% for v in result.items %}
                        <tr data-href="{{ path('app_investigation_show', {id: v.id}) }}" data-action="click->row-link#open">
                            <td class="w-full max-w-0">
                                <a href="{{ path('app_investigation_show', {id: v.id}) }}" class="block truncate font-medium text-fg hover:text-accent">{{ v.incident.title }}</a>
                                <span class="t-meta">{{ v.incident.reference }} · {{ v.shortId }}</span>
                            </td>
                            <td><span class="badge badge-{{ v.status.badge }}">{{ v.status.label }}</span></td>
                            <td>{% if v.engine starts with 'llm:' %}<span class="badge badge-ai">{{ ux_icon('lucide:sparkles') }}AI</span>{% else %}<span class="badge badge-neutral">Heuristic</span>{% endif %}</td>
                            <td class="hidden max-w-sm truncate text-fg-2 md:table-cell">{{ v.summary ? (v.summary|length > 90 ? v.summary|slice(0, 89) ~ '…' : v.summary) : '—' }}</td>
                            <td class="t-meta">{{ v.createdAt|ago }}</td>
                            <td class="num text-right text-fg-2">{{ v.durationSeconds is not null ? v.durationSeconds ~ ' s' : '—' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
