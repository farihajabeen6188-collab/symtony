{% extends 'app/layout.html.twig' %}

{% block title %}Test Lab{% endblock %}

{% block content %}
<twig:PageHeader title="Test Lab" description="Regression tests proposed from investigations. A test is a verified reproduction only after it fails on the buggy build and passes with the fix in the isolated runner.">
    <twig:block name="actions">
        <span class="inline-flex items-center gap-2 text-sm text-fg-2"><span class="dot {{ runner_online ? 'dot-live text-ok' : 'text-err' }}"></span>Runner {{ runner_online ? 'online' : 'offline' }}</span>
    </twig:block>
</twig:PageHeader>

{% if not runner_online %}
    <div class="mb-4 flex gap-3 rounded-lg border border-warn/40 bg-warn-soft p-3 text-sm"><span class="text-fg">The isolated runner is not running, so tests can be reviewed but not executed. Start it with <code>docker compose up -d runner</code>.</span></div>
{% endif %}

<div class="panel overflow-hidden">
    {% if tests is empty %}
        <twig:EmptyState title="No regression tests yet" illustration="no-results">
            Open a completed investigation and choose Generate regression test.
            <twig:block name="actions"><a href="{{ path('app_investigations') }}" class="btn btn-primary">Investigations</a></twig:block>
        </twig:EmptyState>
    {% else %}
        <div class="overflow-x-auto">
            <table class="table" data-controller="row-link">
                <thead><tr><th>Test</th><th>Status</th><th class="hidden sm:table-cell">Written by</th><th class="hidden md:table-cell">Reviewed</th><th class="hidden sm:table-cell">Created</th></tr></thead>
                <tbody>
                    {% for row in tests %}
                        {% set t = row.test %}
                        <tr data-href="{{ path('app_test_show', {id: t.id}) }}" data-action="click->row-link#open">
                            <td class="w-full max-w-0">
                                <a href="{{ path('app_test_show', {id: t.id}) }}" class="block truncate font-medium text-fg hover:text-accent">{{ t.title }}</a>
                                <span class="t-meta">{{ t.incident.reference }} · {{ t.className }}</span>
                            </td>
                            <td>{{ include('test_lab/_status_badge.html.twig', {status: row.status}) }}</td>
                            <td class="hidden sm:table-cell">{% if t.fromModel %}<span class="badge badge-ai">AI</span>{% else %}<span class="badge badge-neutral">Template</span>{% endif %}</td>
                            <td class="hidden text-fg-2 md:table-cell">{{ t.reviewed ? 'Yes' : 'No' }}</td>
                            <td class="hidden t-meta sm:table-cell">{{ t.createdAt|ago }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
