{# Command palette (Ctrl/Cmd+K): server search + contextual actions + navigation; "?" opens the shortcut list. #}
<dialog class="modal modal-palette" data-palette-target="dialog" aria-label="Command palette"
        data-action="close->palette#reset">
    <div class="flex items-center gap-2 border-b border-line px-4">
        {{ ux_icon('lucide:search', {class: 'h-4 w-4 text-fg-3'}) }}
        <input type="text" class="h-12 flex-1 bg-transparent text-md text-fg outline-none placeholder:text-fg-3" placeholder="Search incidents, apps, events by id, or jump to a page…"
               data-palette-target="input" data-action="input->palette#filter keydown->palette#navigate" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list">
        <span class="hidden text-2xs text-fg-3" data-palette-target="spinner" aria-live="polite">Searching…</span>
        <kbd class="kbd">Esc</kbd>
    </div>
    <div id="palette-list" role="listbox" class="max-h-[55vh] overflow-y-auto p-2" data-action="click->palette#remember">
        <ul data-palette-target="recent" role="presentation"></ul>
        <ul data-palette-target="results" role="presentation"></ul>
        <ul data-palette-target="list" role="presentation">
            <li class="px-2 pb-1 pt-3 text-2xs font-medium text-fg-3" role="presentation" data-palette-target="navLabel">Go to</li>
            {% for item in nav_items() %}
                <li>
                    <a href="{{ path(item.route) }}" class="menu-item" role="option" data-palette-target="item" data-keywords="{{ (item.label ~ ' ' ~ item.keywords)|lower }}">
                        {{ ux_icon(item.icon) }}<span class="flex-1">{{ item.label }}</span><span class="text-2xs text-fg-3">{{ item.section }}</span>
                    </a>
                </li>
            {% endfor %}
            <li>
                <a href="{{ path('app_styleguide') }}" class="menu-item" role="option" data-palette-target="item" data-keywords="design system styleguide components">
                    {{ ux_icon('lucide:swatch-book') }}<span class="flex-1">Design system</span><span class="text-2xs text-fg-3">Reference</span>
                </a>
            </li>
        </ul>
    </div>
    <p class="px-4 py-6 text-center text-sm text-fg-3" data-palette-target="empty" hidden>No matches. Try an incident number (SYM-5), a service, or an event id.</p>
    <div class="flex flex-wrap items-center gap-3 border-t border-line px-4 py-2 text-2xs text-fg-3">
        <span class="flex items-center gap-1"><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> to move</span>
        <span class="flex items-center gap-1"><kbd class="kbd">Enter</kbd> to open</span>
        <span class="flex items-center gap-1"><kbd class="kbd">?</kbd> shortcuts</span>
    </div>
</dialog>

<dialog class="modal" data-palette-target="help" aria-labelledby="shortcuts-h">
    <div class="panel-header"><h2 id="shortcuts-h" class="t-h3">Keyboard shortcuts</h2><button type="button" class="btn btn-ghost btn-icon btn-sm" data-action="palette#closeHelp" aria-label="Close">{{ ux_icon('lucide:x') }}</button></div>
    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 p-4 text-sm">
        <dt><kbd class="kbd">Ctrl</kbd> <kbd class="kbd">K</kbd></dt><dd class="text-fg-2">Open the command palette</dd>
        <dt><kbd class="kbd">?</kbd></dt><dd class="text-fg-2">Show this list</dd>
        <dt><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> <kbd class="kbd">Enter</kbd></dt><dd class="text-fg-2">Move and open in the palette</dd>
        <dt><kbd class="kbd">←</kbd> <kbd class="kbd">→</kbd></dt><dd class="text-fg-2">Previous / next event on a timeline</dd>
        <dt><kbd class="kbd">Enter</kbd></dt><dd class="text-fg-2">Open the selected timeline event</dd>
        <dt><kbd class="kbd">E</kbd></dt><dd class="text-fg-2">Errors only on a timeline</dd>
        <dt><kbd class="kbd">Esc</kbd></dt><dd class="text-fg-2">Close dialogs and drawers</dd>
    </dl>
</dialog>
