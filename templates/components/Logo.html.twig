{#
  SYMTONY mark — the investigator (hat + glasses), traced from the brand artwork as vectors.
  Shapes use currentColor; the lens glints use the signal cyan (--accent).
  variant: "mark" | "full" (mark + wordmark)
  motion:  "none" | "hover" (hat tips on hover) | "scan" (glint sweeps the lenses: work in progress)
#}
{% props variant = 'full', class = '', motion = 'hover', label = 'SYMTONY' %}
{% set uid = 'm' ~ random(100000, 999999) %}
{% set mark %}
<svg viewBox="82 150 860 700" xmlns="http://www.w3.org/2000/svg" class="sym-mark {{ motion != 'none' ? 'sym-mark--' ~ motion : '' }} {{ variant == 'mark' ? class : 'h-full w-auto flex-none' }}" role="img" aria-label="{{ label }}">
    <defs>
        <clipPath id="{{ uid }}-lenses">
            <path d="M286 668H502C505 746 486 802 418 810C346 818 300 792 292 732C290 712 287 690 286 668Z M738 668H522C519 746 538 802 606 810C678 818 724 792 732 732C734 712 737 690 738 668Z"/>
        </clipPath>
    </defs>
    <g class="sym-hat" fill="currentColor">
        <path d="M352 230Q356 212 382 212C432 212 470 232 512 233C554 232 592 212 642 212Q668 212 672 230L722 415L728 361C806 369 884 386 908 422C926 450 900 474 858 494C756 560 618 596 512 596C406 596 268 560 166 494C124 474 98 450 116 422C140 386 218 369 296 361L302 415Z"/>
    </g>
    <g class="sym-glasses" fill="currentColor">
        <path d="M282 642C384 626 470 628 512 654C554 628 640 626 742 642C762 645 764 676 744 681L530 681C523 668 501 668 494 681L280 681C260 676 262 645 282 642Z"/>
        <path d="M286 668H502C505 746 486 802 418 810C346 818 300 792 292 732C290 712 287 690 286 668Z"/>
        <path d="M738 668H522C519 746 538 802 606 810C678 818 724 792 732 732C734 712 737 690 738 668Z"/>
    </g>
    <g class="sym-glint" fill="var(--accent)">
        <path d="M308 696C314 674 340 660 368 659C342 668 324 682 318 704Z"/>
        <path d="M558 696C564 674 590 660 618 659C592 668 574 682 568 704Z"/>
    </g>
    {% if motion == 'scan' %}
        <g clip-path="url(#{{ uid }}-lenses)">
            <rect class="sym-sweep" x="200" y="600" width="70" height="260" fill="var(--accent)" opacity="0.55" transform="skewX(-22)"/>
        </g>
    {% endif %}
</svg>
{% endset %}
{% if variant == 'mark' %}
    {{ mark }}
{% else %}
    <span {{ attributes.defaults({class: 'inline-flex items-center gap-2.5 ' ~ class}) }}>
        {{ mark }}
        <span class="text-[0.95em] font-[680] leading-none tracking-[0.16em]">SYMTONY</span>
    </span>
{% endif %}
