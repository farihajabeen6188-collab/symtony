{#
  Line illustrations in the brand style (thin strokes, event nodes, one accent).
  name: trace | no-apps | no-incidents | no-results
#}
{% props name = 'no-results', class = '' %}
{% if name == 'trace' %}
<svg class="{{ class }}" viewBox="0 0 600 640" preserveAspectRatio="xMinYMid slice" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <pattern id="ill-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" stroke="var(--line)" stroke-width="1"/></pattern>
    </defs>
    <rect width="600" height="640" fill="url(#ill-grid)"/>
    {% set lanes = [{y: 110, label: 'http'}, {y: 190, label: 'checkout'}, {y: 270, label: 'inventory'}, {y: 350, label: 'payment-api'}, {y: 430, label: 'database'}] %}
    {% for lane in lanes %}
        <line x1="40" x2="580" y1="{{ lane.y }}" y2="{{ lane.y }}" stroke="var(--line)" />
        <text x="40" y="{{ lane.y - 10 }}" fill="var(--fg-3)" font-family="JetBrains Mono, monospace" font-size="11">{{ lane.label }}</text>
    {% endfor %}
    <rect x="70" y="102" width="470" height="16" rx="3" fill="var(--blue-soft)" stroke="var(--blue)" stroke-opacity="0.5"/>
    <rect x="96" y="182" width="420" height="16" rx="3" fill="var(--surface-3)" stroke="var(--line-strong)"/>
    <rect x="120" y="262" width="70" height="16" rx="3" fill="var(--surface-3)" stroke="var(--line-strong)"/>
    <rect x="210" y="342" width="150" height="16" rx="3" fill="var(--ok-soft)" stroke="var(--ok)" stroke-opacity="0.5"/>
    <rect x="380" y="422" width="60" height="16" rx="3" fill="var(--err-soft)" stroke="var(--err)"/>
    <path d="M155 278V342M285 358V410H410V422" stroke="var(--fg-3)" stroke-width="1.2"/>
    <path d="M190 270C260 250 300 300 380 300" stroke="var(--fg-3)" stroke-dasharray="4 4" stroke-width="1.2"/>
    <circle cx="410" cy="430" r="15" stroke="var(--accent)" stroke-width="1.5"/>
    <circle cx="410" cy="430" r="4" fill="var(--err)"/>
    <line x1="410" x2="410" y1="160" y2="560" stroke="var(--err)" stroke-opacity="0.35" stroke-dasharray="2 6"/>
</svg>
{% elseif name == 'no-apps' %}
<svg class="{{ class }}" viewBox="0 0 160 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="8" y="28" width="52" height="40" rx="6" stroke="var(--line-strong)" stroke-width="1.5"/>
    <path d="M18 40h32M18 48h20M18 56h26" stroke="var(--fg-3)" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M60 48h18" stroke="var(--fg-3)" stroke-width="1.5" stroke-dasharray="3 4"/>
    <circle cx="84" cy="48" r="5" stroke="var(--accent)" stroke-width="1.5"/>
    <path d="M89 48h14" stroke="var(--fg-3)" stroke-width="1.5" stroke-dasharray="3 4"/>
    <rect x="104" y="30" width="48" height="36" rx="18" stroke="var(--line-strong)" stroke-width="1.5"/>
    <path d="M112 50l6-8 5 12 6-16 4 8h7" stroke="var(--fg-2)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{% elseif name == 'no-incidents' %}
<svg class="{{ class }}" viewBox="0 0 160 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M6 60h148" stroke="var(--line)" stroke-width="1.5"/>
    <path d="M6 56h30l6-6 6 6h28l5-4 5 4h68" stroke="var(--fg-3)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="112" cy="32" r="14" stroke="var(--ok)" stroke-width="1.5"/>
    <path d="M105 32l5 5 9-10" stroke="var(--ok)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{% else %}
<svg class="{{ class }}" viewBox="0 0 160 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M10 60h20M38 60h12M58 60h26M92 60h8M108 60h40" stroke="var(--fg-3)" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="74" cy="42" r="16" stroke="var(--line-strong)" stroke-width="1.5"/>
    <path d="M86 54l14 14" stroke="var(--fg-2)" stroke-width="2" stroke-linecap="round"/>
    <path d="M68 42h12" stroke="var(--fg-3)" stroke-width="1.5" stroke-linecap="round"/>
</svg>
{% endif %}
