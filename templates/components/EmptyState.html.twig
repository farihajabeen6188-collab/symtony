{% props title, illustration = 'no-results', compact = false %}
<div {{ attributes.defaults({class: 'flex flex-col items-center justify-center text-center ' ~ (compact ? 'px-6 py-10' : 'px-6 py-16')}) }}>
    <twig:Illustration name="{{ illustration }}" class="{{ compact ? 'h-14' : 'h-20' }} w-auto" />
    <h2 class="mt-5 t-h2">{{ title }}</h2>
    <div class="mt-1.5 max-w-md text-sm text-fg-2">{% block content %}{% endblock %}</div>
    {% if block('actions') is defined %}
        <div class="mt-5 flex flex-wrap items-center justify-center gap-2">{% block actions %}{% endblock %}</div>
    {% endif %}
</div>
