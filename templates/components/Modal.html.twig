{#
  Native <dialog> modal. Open with: <button data-action="dialog#open" data-dialog-id-param="my-id">.
  The dialog controller lives on <body>-level elements via data-controller="dialog".
#}
{% props id, title, description = null, wide = false %}
<dialog id="{{ id }}" {{ attributes.defaults({class: 'modal ' ~ (wide ? 'modal-wide' : '')}) }} aria-labelledby="{{ id }}-title">
    <div class="flex items-start justify-between gap-4 border-b border-line px-5 py-4">
        <div>
            <h2 id="{{ id }}-title" class="t-h2">{{ title }}</h2>
            {% if description %}<p class="mt-0.5 text-sm text-fg-2">{{ description }}</p>{% endif %}
        </div>
        <form method="dialog"><button class="btn btn-ghost btn-icon btn-sm" aria-label="Close">{{ ux_icon('lucide:x') }}</button></form>
    </div>
    <div class="max-h-[70vh] overflow-y-auto px-5 py-4">{% block content %}{% endblock %}</div>
    {% if block('footer') is defined %}
        <div class="flex justify-end gap-2 border-t border-line px-5 py-3">{% block footer %}{% endblock %}</div>
    {% endif %}
</dialog>
