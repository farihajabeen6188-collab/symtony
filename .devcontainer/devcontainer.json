{
    "name": "SYMTONY",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "hostRequirements": { "cpus": 2, "memory": "8gb" },
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": { "label": "SYMTONY", "onAutoForward": "silent" },
        "8081": { "label": "Demo shop (internal)", "onAutoForward": "ignore" },
        "5433": { "label": "PostgreSQL (internal)", "onAutoForward": "ignore" }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postStartCommand": "bash .devcontainer/start.sh",
    "customizations": {
        "codespaces": { "openFiles": ["README.md"] }
    }
}
